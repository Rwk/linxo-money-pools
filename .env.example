# Public application metadata
NEXT_PUBLIC_APP_NAME=Linxo Money Pools

# Local application routing (DEV-4 will document ngrok)
# Optional later: replace this value with your HTTPS ngrok origin for callbacks.
# Keep one NEXTAUTH_URL entry; restart Next.js after edits.
NEXTAUTH_URL="http://localhost:3000"

# Authentication: existing Google/Auth.js behavior remains in place.
# DEV-2: opt-in passwordless local identity; disabled in production and Vercel.
ENABLE_DEV_AUTH=false
# AUTH_SECRET is still required. Google credentials are optional with dev auth.
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Server-only database
# Local Docker PostgreSQL only; Vercel keeps its platform-managed Supabase URL.
# See docs/local-development.md before starting the application.
DATABASE_URL="postgresql://linxo_dev:linxo_dev_only@127.0.0.1:5433/linxo_money_pools_dev"

# Linxo Payments Sandbox ONLY; never use production credentials here.
# Obtain the sandbox endpoint and matching sandbox credentials from Linxo.
# ENVIRONMENT is a validated label; it does NOT select the endpoint or credentials.
LINXO_PAYMENTS_BASE_URL="https://replace-with-linxo-sandbox-base-url.example"
LINXO_PAYMENTS_CLIENT_ID="replace-with-linxo-sandbox-client-id"
LINXO_PAYMENTS_CLIENT_SECRET="replace-with-linxo-sandbox-client-secret"
LINXO_PAYMENTS_ENVIRONMENT="sandbox"
LINXO_WEBHOOK_SECRET="replace-with-new-local-webhook-secret"
LINXO_API_LOG_LEVEL="off"
